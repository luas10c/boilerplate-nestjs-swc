{
  "name": "boilerplate-nestjs-swc",
  "description": "Nest.js boilerplate lightweight",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:debug": "nest start --debug --watch",
    "build": "nest build",
    "lint": "eslint --cache --concurrency=auto",
    "test": "node --experimental-vm-modules --no-warnings node_modules/.bin/jest --passWithNoTests",
    "test:ci": "node --experimental-vm-modules --no-warnings node_modules/.bin/jest --passWithNoTests --ci",
    "test:watch": "node --experimental-vm-modules --no-warnings node_modules/.bin/jest --passWithNoTests --watch",
    "test:watchAll": "node --experimental-vm-modules --no-warnings node_modules/.bin/jest --passWithNoTests --watchAll",
    "test:coverage": "node --experimental-vm-modules --no-warnings node_modules/.bin/jest --passWithNoTests --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@scalar/nestjs-api-reference": "^1.2.17",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@jest/globals": "^30.5.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/node": "^26.4.1",
    "@types/supertest": "^7.2.1",
    "chokidar": "^5.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-plugin-jest": "^29.16.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jest-environment-node": "^30.5.1",
    "jest-mock-extended": "4.0.1",
    "msw": "^2.15.0",
    "neostaged": "^0.2.0",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "license": "UNLICENSED"
}
