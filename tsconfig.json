{
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": true,
    "skipLibCheck": true,

    "noImplicitReturns": true,
    "noImplicitAny": true,

    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",

    "esModuleInterop": true,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "paths": {
      "#/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.spec.ts", "**/*.test.ts"]
}
